<!doctype html>
<html class="h-full">
  <head> 
    <meta charset="UTF-8">  
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="./css/reboot.css" rel="stylesheet">
    <link href="./css/output.css" rel="stylesheet">
  </head>
  <body class="h-full  bg-[url('/images/forest.jpg')] bg-center bg-cover bg-no-repeat grid grid-rows-[10%_1fr] grid-cols-[20%_1fr] gap-8 p-4"> 
    <nav class="border-4 border-white rounded-lg  glass relative flex justify-center items-center row-start-1 row-span-1 col-start-1 col-span-2">
      <h1 class="text-white border-white p-2 text-5xl">HoogleDrive</h1>
      <span class="absolute right-4 top-1/2 -translate-y-1/2">
        <ion-icon size="large" name="log-out-outline" class="text-white"></ion-icon>
      </span>
    </nav>
  <aside class="glass border-4 border-white rounded-lg flex flex-col gap-4 p-4">
    <a href="/upload" class="rounded-lg h-10 bg-white text-black flex items-center justify-center hover:bg-gray-200">
      Upload File
    </a>
    <a href="/folders" class=" cursor-pointer rounded-lg h-10 bg-white text-black flex items-center justify-center hover:bg-gray-200">
      View Folders
    </a>
    <a href="/folders/files/all" class="cursor-pointer rounded-lg h-10 bg-white text-black flex items-center justify-center hover:bg-gray-200">
      View All Files
    </a>
  </aside>
  <main class="border-4 border-white rounded-lg glass row-start-2 row-span-1 col-start-2 col-span-1 flex items-center justify-center p-8">
    <form action="/upload" enctype="multipart/form-data" method="post" class="flex flex-col gap-6 w-full max-w-md text-white">
      <h2 class="text-3xl font-bold mb-4 text-center">Upload a File</h2>

      <div class="flex flex-col gap-2">
        <label for="folderId" class="text-lg font-semibold">Select Folder</label>
        <select name="folderId" id="folderId" class="p-2 rounded-md bg-white text-black focus:outline-none focus:ring-2 focus:ring-green-400">
          <% folders.forEach((folder)=>{ %>
            <option value="<%= folder.id %>"><%= folder.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="flex flex-col gap-2">
        <label for="uploaded_file" class="text-lg font-semibold">Choose File</label>
        <input type="file" name="uploaded_file" id="uploaded_file" class="p-2 rounded-md bg-white text-black file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:bg-green-400 file:text-black file:font-semibold hover:file:bg-green-300">
      </div>

      <button type="submit" class="mt-4 py-3 px-6 bg-green-500  text-black font-bold rounded-lg hover:bg-green-300 transition duration-200">
        Upload File
      </button>
    </form>
  </main>
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
  </body>
</html>
