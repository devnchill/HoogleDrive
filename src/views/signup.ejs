<!doctype html>
<html class="h-full">
  <head>
    <link rel="stylesheet" href="/css/reboot.css" />
    <link rel="stylesheet" href="/css/output.css" />
  </head>
  <body class="h-full bg-[url('/images/forest.jpg')] bg-center bg-cover bg-no-repeat flex justify-center items-center">
    <div id="form-container" class="outline outline-white p-12 rounded-md backdrop-blur-lg">
      <form method="POST" action="/signup">
        <div class="flex flex-col">
          <label class="text-white">UserName:</label>
          <input required name="userName" value="<%= formData.userName || '' %>" class="border border-white"/>
          <% if (err.userName) { %>
            <span ><%= err.userName %></span>
          <% } %>
        </div>

        <div class="flex flex-col">
          <label class="text-white">Email:</label>
          <input required name="email" value="<%= formData.email || '' %>"class="border border-white"/>
          <% if (err.email) { %>
            <span ><%= err.email %></span>
          <% } %>
        </div>

        <div class="flex flex-col">
          <label class="text-white">Password:</label>
          <input required name="password" type="password" value="<%= formData.password || '' %>" class="border border-white"/>
          <% if (err.password) { %>
            <span ><%= err.password %></span>
          <% } %>
        </div>

        <div class="flex flex-col">
          <label class="text-white">Confirm Password:</label>
          <input required name="confirmPassword" type="password" value="<%= formData.confirmPassword || '' %>"class="border border-white"/>
          <% if (err.confirmPassword) { %>
            <span ><%= err.confirmPassword %></span>
          <% } %>
        </div>
        <button type="submit" class="text-white">Submit</button>
      </form>
      <p class="text-white">Already a User? <a href='/login' class="text-blue-500"> Login</a> </p>
    </div>
  </body>
</html>
